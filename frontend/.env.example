# URL of the Calorio backend (no trailing slash). Set this in Vercel > Project > Settings > Environment Variables.
VITE_API_URL=https://calorio-app.onrender.com

# Optional: link to the classic Django site for pages not yet in the React app (Analytics, Recipes, Saved meals, Account...).
VITE_CLASSIC_URL=https://calorio-app.onrender.com
